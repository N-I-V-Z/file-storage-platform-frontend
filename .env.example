# Public browser URL for the NestJS API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Server-side URL for Next.js Server Components and route handlers.
API_INTERNAL_URL=http://127.0.0.1:4000/api/v1
# Exact public origin used by canonical, Open Graph, robots.txt and sitemap.xml.
# Set this to the HTTPS production domain before deploying; do not leave localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000
