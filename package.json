{
  "name": "file-storage-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write app public src test *.ts *.mjs *.json",
    "format:check": "prettier --check app public src test *.ts *.mjs *.json",
    "test": "node --test test/*.test.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
